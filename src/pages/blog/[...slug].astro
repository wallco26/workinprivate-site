---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const dateFmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });

const siteUrl = 'https://www.workinprivate.com';
const url = `${siteUrl}/blog/${post.id}`;
---

<BaseLayout title={`${post.data.title} | WorkInPrivate`} description={post.data.description}>
  <!-- BlogPosting structured data -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "headline": post.data.title,
    "description": post.data.description,
    "datePublished": post.data.pubDate.toISOString(),
    ...(post.data.updatedDate ? { "dateModified": post.data.updatedDate.toISOString() } : {}),
    "author": { "@type": "Organization", "name": post.data.author },
    "publisher": {
      "@type": "Organization",
      "name": "Wallco Digital Labs LLC",
      "logo": { "@type": "ImageObject", "url": `${siteUrl}/favicon.svg` },
    },
    "mainEntityOfPage": { "@type": "WebPage", "@id": url },
    "url": url,
  })} />

  <article class="py-16 sm:py-20 bg-white">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl mx-auto">
        <!-- Header -->
        <div class="mb-10 text-center">
          <div class="flex items-center justify-center gap-3 mb-4">
            <span class="text-xs font-bold uppercase tracking-wider text-[#4B8BD4] bg-[#EDF2FA] px-2.5 py-1 rounded-full">{post.data.category}</span>
            <span class="text-xs text-[#8A9AB5]">{dateFmt(post.data.pubDate)}</span>
          </div>
          <h1 class="font-serif text-3xl sm:text-4xl font-bold text-[#1B3A5C] mb-4 leading-tight">{post.data.title}</h1>
          <p class="text-lg text-[#5A6474] leading-relaxed">{post.data.description}</p>
        </div>

        <!-- Body -->
        <div class="prose-wip">
          <Content />
        </div>

        <!-- Inline CTA -->
        <div class="mt-12 bg-[#EDF2FA] border-2 border-[#D4E3F5] rounded-2xl p-8 text-center">
          <h2 class="font-serif text-2xl font-bold text-[#1B3A5C] mb-3">Keep your work private</h2>
          <p class="text-[#5A6474] mb-6 leading-relaxed">WorkInPrivate runs an AI assistant entirely on your own computer — no cloud, no account, no data used to train AI.</p>
          <a href="/download" class="inline-flex items-center px-7 py-3.5 text-base font-bold rounded-[10px] text-white bg-[#4B8BD4] hover:bg-[#2E6BB5] transition-colors no-underline" style="text-decoration: none; box-shadow: 0 4px 14px rgba(75,139,212,0.35);">
            Start Free Trial
          </a>
          <p class="text-[#8A9AB5] text-sm mt-4">Free 7-day trial — no credit card. Then $49.99 one-time.</p>
        </div>

        <!-- Back link -->
        <div class="mt-10 text-center">
          <a href="/blog" class="inline-flex items-center gap-1.5 text-[#4B8BD4] font-bold no-underline hover:text-[#2E6BB5]" style="text-decoration: none;">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M19 12H5M12 19l-7-7 7-7" /></svg>
            All posts
          </a>
        </div>
      </div>
    </div>
  </article>
</BaseLayout>

<style is:global>
  /* Lightweight prose styling for blog post bodies (Friendly Neighbor). */
  .prose-wip { color: #5A6474; font-size: 1.0625rem; line-height: 1.8; }
  .prose-wip h2 { font-family: Merriweather, Georgia, serif; color: #1B3A5C; font-size: 1.5rem; font-weight: 700; margin-top: 2.25rem; margin-bottom: 0.9rem; line-height: 1.3; }
  .prose-wip h3 { font-family: Merriweather, Georgia, serif; color: #1B3A5C; font-size: 1.2rem; font-weight: 700; margin-top: 1.75rem; margin-bottom: 0.6rem; }
  .prose-wip p { margin-bottom: 1.15rem; }
  .prose-wip ul, .prose-wip ol { margin: 0 0 1.15rem 1.25rem; }
  .prose-wip li { margin-bottom: 0.5rem; }
  .prose-wip ul { list-style: disc; }
  .prose-wip ol { list-style: decimal; }
  .prose-wip a { color: #4B8BD4; font-weight: 600; text-decoration: underline; }
  .prose-wip a:hover { color: #2E6BB5; }
  .prose-wip strong { color: #1B3A5C; font-weight: 700; }
  .prose-wip blockquote { border-left: 4px solid #4B8BD4; padding-left: 1.25rem; margin: 1.5rem 0; font-style: italic; color: #1B3A5C; }
  .prose-wip code { background: #EDF2FA; color: #2E6BB5; padding: 0.15em 0.4em; border-radius: 5px; font-size: 0.9em; font-family: 'JetBrains Mono', monospace; }
  .prose-wip hr { border: none; border-top: 2px solid #E2E8F0; margin: 2.5rem 0; }
  .prose-wip table { width: 100%; border-collapse: collapse; margin: 1.5rem 0; font-size: 0.98em; }
  .prose-wip th, .prose-wip td { border: 1px solid #E2E8F0; padding: 0.6rem 0.85rem; text-align: left; }
  .prose-wip thead th { background: #EDF2FA; color: #1B3A5C; font-weight: 700; }
  .prose-wip tbody tr:nth-child(even) { background: #F7F9FC; }
  .prose-wip h2:first-child, .prose-wip h3:first-child { margin-top: 0; }
</style>
