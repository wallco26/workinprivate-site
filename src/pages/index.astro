  <script>
    // Homepage preview rotation: switch between example conversations.
    const TAB_ACTIVE = 'preview-tab px-3 py-1.5 rounded-full text-xs font-bold transition-all border cursor-pointer bg-[#4B8BD4] text-white border-[#4B8BD4]';
    const TAB_INACTIVE = 'preview-tab px-3 py-1.5 rounded-full text-xs font-bold transition-all border cursor-pointer bg-[#EDF2FA] text-[#2E6BB5] border-[#D4E3F5] hover:border-[#4B8BD4]';
    const tabs = document.querySelectorAll<HTMLButtonElement>('.preview-tab');
    const panels = document.querySelectorAll<HTMLElement>('.preview-panel');
    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const idx = tab.dataset.panel;
        tabs.forEach((t) => {
          const active = t === tab;
          t.className = active ? TAB_ACTIVE : TAB_INACTIVE;
          t.setAttribute('aria-selected', active ? 'true' : 'false');
        });
        panels.forEach((p) => {
          p.hidden = p.dataset.panel !== idx;
        });
      });
    });
  </script>

