---
import BaseLayout from '../layouts/BaseLayout.astro';

// Homepage preview rotation — private-by-necessity examples (professional-first).
// All names, dates, and dollar amounts are fictional. Badges are architecture
// claims only (never compliance certifications like "HIPAA-compliant").
const previewPanels = [
  {
    tab: 'For lawyers',
    files: ['discovery_responses.pdf', 'deposition_transcript.pdf'],
    prompt: 'Where do the opposing party’s written discovery answers contradict my client’s deposition testimony? Cite each inconsistency by page.',
    response: 'I found 4 inconsistencies. The clearest: Interrogatory No. 7 states the agreement was signed on March 12 — but in the deposition transcript (p. 84), their witness testifies it was signed “a couple of weeks after the April walkthrough.” Second…',
    badge: 'Processed on this device. Privileged material never leaves your machine.',
  },
  {
    tab: 'For therapists',
    files: ['session_notes_tue.docx'],
    prompt: 'Here are my raw notes from today’s sessions. Draft SOAP-format progress notes for each, and flag anything I should follow up on next week.',
    response: 'Done — 3 progress notes drafted in SOAP format, ready for your review. One follow-up flag: your second session’s notes mention a medication change made by the client’s psychiatrist — you may want to add a coordination-of-care note…',
    badge: 'Processed on this device. Session notes never leave your machine.',
  },
  {
    tab: 'Health',
    files: ['visit_summary.pdf', 'insurance_eob.pdf'],
    prompt: 'Explain what I was billed for, what insurance actually covered, and what I may still owe — in plain English.',
    response: 'Here’s the breakdown. You were billed $1,142 across four line items. Insurance covered the office visit ($210) and the metabolic panel ($96) in full. The ultrasound ($680) was applied to your deductible, so you may still owe…',
    badge: 'Processed on this device. Nothing was sent to the internet.',
  },
  {
    tab: 'Legal',
    files: ['severance_agreement.pdf'],
    prompt: 'I was just handed this severance agreement and I have 48 hours to sign. Flag any risky clauses or unusual deadlines, and tell me what I should ask a lawyer about.',
    response: 'Three things stand out. Section 8’s non-solicitation clause runs 24 months — longer than the 12 typical for agreements like this. And the release in Section 4 covers “known and unknown claims,” which is broad — worth asking a lawyer exactly what you’d be waiving…',
    badge: 'Processed on this device. Nothing was sent to the internet.',
  },
  {
    tab: 'Money',
    files: ['w-2.pdf', '1099-nec.pdf', 'brokerage_statement.pdf'],
    prompt: 'Summarize the key numbers I’ll need for my tax return, and point out anything that looks inconsistent.',
    response: 'Key numbers: W-2 wages of $84,300 (Box 1) with $9,610 federal withholding; 1099-NEC income of $12,750 with no withholding — expect self-employment tax on that portion. One thing to check: $410 of your $1,340 in dividends is listed as non-qualified…',
    badge: 'Processed on this device. Nothing was sent to the internet.',
  },
];
---

<BaseLayout title="Private ChatGPT Alternative | WorkInPrivate" description="WorkInPrivate is a private ChatGPT alternative that runs on your own computer. Your chats and files never leave your machine — no cloud, no account, no data used to train AI. One-time $29.99.">

  <!-- JSON-LD Structured Data -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "name": "WorkInPrivate",
    "description": "A private ChatGPT alternative that runs on your own computer. Your conversations and files never leave your machine — no cloud, no account, no data used to train AI. One-time purchase, no subscription.",
    "url": "https://www.workinprivate.com",
    "applicationCategory": "UtilitiesApplication",
    "operatingSystem": "Windows, macOS, Linux",
    "offers": {
      "@type": "Offer",
      "price": "29.99",
      "priceCurrency": "USD",
      "availability": "https://schema.org/InStock"
    },
    "featureList": [
      "Your chats and files never leave your computer",
      "Chat with AI like ChatGPT — but private",
      "Never uses your data to train AI",
      "Works offline — no internet needed after setup",
      "No accounts, no command line, no setup headaches",
      "One-time purchase — no subscription",
      "Works on Windows, macOS, and Linux"
    ]
  })} />

  <!-- Hero Section -->
  <section class="py-20 bg-gradient-to-b from-white to-[#F7F9FC]">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
        <!-- Text content -->
        <div>
          <div class="inline-flex items-center gap-2 px-4 py-2.5 rounded-full bg-[#F0FFF4] text-[#38A169] text-sm font-bold mb-5 border border-[#C6F6D5]" style="animation: fadeUp 0.5s ease both;">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0110 0v4"/></svg>
            100% private — nothing leaves your computer
          </div>
          <h1 class="font-serif text-4xl sm:text-5xl font-bold text-[#1B3A5C] mb-5 leading-tight" style="animation: fadeUp 0.5s ease 0.1s both;">
            Private AI that <span class="text-[#4B8BD4]">never leaves your computer.</span>
          </h1>
          <p class="text-lg text-[#5A6474] mb-8 max-w-lg leading-relaxed" style="animation: fadeUp 0.5s ease 0.2s both;">
            WorkInPrivate is a ChatGPT-style assistant for Windows, Mac, and Linux that runs right on your own machine. Your conversations and files stay with you — no cloud, no account, and nothing is ever used to train AI.
          </p>
          <div class="flex flex-wrap gap-4 mb-7" style="animation: fadeUp 0.5s ease 0.3s both;">
            <a href="/download" class="inline-flex items-center gap-2.5 px-8 py-4 rounded-[10px] text-white font-bold text-lg bg-[#4B8BD4] hover:bg-[#2E6BB5] transition-all no-underline" style="text-decoration: none; box-shadow: 0 2px 8px rgba(75,139,212,0.3);">
              Start Your Free Trial
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>
            <a href="#how-it-works" class="inline-flex items-center gap-2 px-8 py-4 rounded-[10px] text-[#2E6BB5] font-bold text-lg bg-[#EDF2FA] hover:bg-[#D4E3F5] border-2 border-[#D4E3F5] hover:border-[#4B8BD4] transition-all no-underline" style="text-decoration: none;">
              See How It Works
            </a>
          </div>
          <p class="text-sm text-[#8A9AB5]" style="animation: fadeUp 0.5s ease 0.4s both;">Free 7-day trial &mdash; no account, no credit card. Then $29.99 one-time to keep it. Windows, macOS &amp; Linux.</p>
        </div>
        <!-- Chat UI Preview (tabbed rotation: professional examples first) -->
        <div class="max-w-md mx-auto w-full">
          <div class="text-xs font-bold uppercase tracking-widest text-[#4B8BD4] text-center mb-3">Preview:</div>
          <!-- Preview tabs -->
          <div class="flex flex-wrap justify-center gap-1.5 mb-3" role="tablist" aria-label="Example conversations">
            {previewPanels.map((panel, i) => (
              <button
                type="button"
                role="tab"
                aria-selected={i === 0 ? 'true' : 'false'}
                data-panel={String(i)}
                class={`preview-tab px-3 py-1.5 rounded-full text-xs font-bold transition-all border cursor-pointer ${i === 0 ? 'bg-[#4B8BD4] text-white border-[#4B8BD4]' : 'bg-[#EDF2FA] text-[#2E6BB5] border-[#D4E3F5] hover:border-[#4B8BD4]'}`}
              >{panel.tab}</button>
            ))}
          </div>
          <div class="bg-white rounded-2xl border-2 border-[#D4E3F5] overflow-hidden" style="box-shadow: 0 8px 32px rgba(27,58,92,0.10);">
            <!-- Chat header -->
            <div class="flex items-center gap-2 px-4 py-3 bg-[#F7F9FC] border-b border-[#E2E8F0]">
              <div class="w-3 h-3 rounded-full bg-[#38A169]"></div>
              <span class="text-xs font-bold text-[#1B3A5C]">WorkInPrivate</span>
              <span class="text-xs text-[#8A9AB5] ml-auto">100% local</span>
            </div>
            <!-- Chat messages (one panel per example) -->
            {previewPanels.map((panel, i) => (
              <div class="preview-panel p-4 space-y-4" data-panel={String(i)} hidden={i !== 0}>
                <div class="flex gap-3">
                  <div class="w-7 h-7 rounded-full bg-[#4B8BD4] flex items-center justify-center text-white text-[10px] font-bold flex-shrink-0">You</div>
                  <div class="bg-[#F7F9FC] rounded-xl px-3 py-2 text-sm text-[#1B3A5C]">
                    <div class="flex flex-wrap gap-1.5 mb-2">
                      {panel.files.map((file) => (
                        <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md bg-white border border-[#E2E8F0] text-[10px] font-bold text-[#2E6BB5]">
                          <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21.44 11.05l-9.19 9.19a6 6 0 01-8.49-8.49l9.19-9.19a4 4 0 015.66 5.66l-9.2 9.19a2 2 0 01-2.83-2.83l8.49-8.48"/></svg>
                          {file}
                        </span>
                      ))}
                    </div>
                    {panel.prompt}
                  </div>
                </div>
                <div class="flex gap-3">
                  <div class="w-7 h-7 rounded-full bg-[#EDF2FA] flex items-center justify-center text-[#4B8BD4] text-[10px] font-bold flex-shrink-0">AI</div>
                  <div class="bg-[#EDF2FA] rounded-xl px-3 py-2 text-sm text-[#1B3A5C]">{panel.response}</div>
                </div>
                <div class="flex items-center justify-center gap-1.5 text-[11px] font-bold text-[#38A169] pt-1">
                  <svg class="w-3.5 h-3.5 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0110 0v4"/></svg>
                  {panel.badge}
                </div>
              </div>
            ))}
            <!-- Input bar -->
            <div class="flex items-center gap-2 px-4 py-3 border-t border-[#E2E8F0]">
              <div class="flex-1 h-8 bg-[#F7F9FC] rounded-lg border border-[#E2E8F0]"></div>
              <div class="w-8 h-8 rounded-lg bg-[#4B8BD4] flex items-center justify-center">
                <svg class="w-4 h-4 text-white" viewBox="0 0 24 24" fill="currentColor"><path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z"/></svg>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- What Is This Section -->
  <section class="py-20 bg-[#EDF2FA] border-t-2 border-b-2 border-[#D4E3F5]">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mx-auto text-center">
        <div class="text-xs font-bold uppercase tracking-widest text-[#4B8BD4] mb-3">How It's Different</div>
        <h2 class="font-serif text-3xl sm:text-4xl font-bold text-[#1B3A5C] mb-5 leading-tight">A ChatGPT Alternative That Runs On Your Computer, Not The Cloud</h2>
        <p class="text-lg text-[#5A6474] leading-relaxed mb-4">
          Most AI tools, like ChatGPT, send everything you type to a company's servers over the internet. WorkInPrivate is different: the AI runs right on your own computer. Your questions, your documents, and your files stay with you — there's no server to send them to, and nothing you type is ever used to train AI.
        </p>
        <p class="text-lg text-[#5A6474] leading-relaxed">
          It's the same kind of chat experience you're used to, kept completely private. Try it free for 7 days, then pay once ($29.99) and it's yours forever. No monthly bills. No data collection. No one reading your conversations.
        </p>
      </div>
    </div>
  </section>

  <!-- If You Can Text, You Can Use It Section -->
  <section class="py-20 bg-white">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-5xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div>
          <div class="text-xs font-bold uppercase tracking-widest text-[#4B8BD4] mb-3">No Tech Skills Needed</div>
          <h2 class="font-serif text-3xl sm:text-4xl font-bold text-[#1B3A5C] mb-5 leading-tight">If You Can Text, You Can Use It</h2>
          <p class="text-lg text-[#5A6474] leading-relaxed mb-4">
            Running private AI on your own computer normally means wrestling with confusing tools and settings built for tech enthusiasts. That's fine for hobbyists. It's miserable for everyone else.
          </p>
          <p class="text-lg text-[#5A6474] leading-relaxed">
            WorkInPrivate does the technical part for you. It gets everything ready behind a friendly window — no command line, no files to configure, no guesswork. You just open it and start typing, like any chat app you already know.
          </p>
        </div>
        <div class="space-y-4">
          <div class="flex items-start gap-4 bg-[#F0FFF4] border-2 border-[#C6F6D5] rounded-xl p-5">
            <svg class="w-6 h-6 text-[#38A169] flex-shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg>
            <div>
              <h3 class="font-bold text-[#1B3A5C] text-base mb-1">It picks the right AI for you</h3>
              <p class="text-[#5A6474] text-sm leading-relaxed">No comparing model names or specs. WorkInPrivate looks at your computer and recommends one that fits.</p>
            </div>
          </div>
          <div class="flex items-start gap-4 bg-[#F0FFF4] border-2 border-[#C6F6D5] rounded-xl p-5">
            <svg class="w-6 h-6 text-[#38A169] flex-shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg>
            <div>
              <h3 class="font-bold text-[#1B3A5C] text-base mb-1">No command line, ever</h3>
              <p class="text-[#5A6474] text-sm leading-relaxed">Everything happens in a normal app window with buttons you can actually understand.</p>
            </div>
          </div>
          <div class="flex items-start gap-4 bg-[#F0FFF4] border-2 border-[#C6F6D5] rounded-xl p-5">
            <svg class="w-6 h-6 text-[#38A169] flex-shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg>
            <div>
              <h3 class="font-bold text-[#1B3A5C] text-base mb-1">If you can text, you can use it</h3>
              <p class="text-[#5A6474] text-sm leading-relaxed">It works like any chat app you already know. Type a message, get an answer.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- How It Works Section -->
  <section id="how-it-works" class="py-20 bg-[#F7F9FC] border-t-2 border-[#E2E8F0]">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-4">
        <div class="text-xs font-bold uppercase tracking-widest text-[#4B8BD4] mb-3">How It Works</div>
        <h2 class="font-serif text-3xl sm:text-4xl font-bold text-[#1B3A5C] mb-4 leading-tight">Three Simple Steps</h2>
        <p class="text-lg text-[#5A6474] max-w-lg mx-auto">No complicated setup. No technical knowledge required. If you can use a chat app, you can use WorkInPrivate.</p>
      </div>
      <div class="max-w-5xl mx-auto grid grid-cols-1 md:grid-cols-3 gap-8 mt-12">
        <!-- Step 1 -->
        <div class="bg-[#F7F9FC] border-2 border-[#E2E8F0] rounded-2xl p-9 text-center hover:border-[#D4E3F5] transition-all">
          <div class="w-16 h-16 rounded-full bg-[#EDF2FA] border-2 border-[#D4E3F5] flex items-center justify-center mx-auto mb-5">
            <svg class="w-7 h-7 text-[#4B8BD4]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/><polyline points="7,10 12,15 17,10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
          </div>
          <div class="text-xs font-bold uppercase tracking-wider text-[#4B8BD4] mb-2.5">Step 1</div>
          <h3 class="font-serif text-lg font-bold text-[#1B3A5C] mb-3">Install WorkInPrivate</h3>
          <p class="text-[#5A6474] text-base leading-relaxed">Download the app and double-click to open it — just like installing any other program. No accounts to create, nothing to configure.</p>
        </div>
        <!-- Step 2 -->
        <div class="bg-[#F7F9FC] border-2 border-[#E2E8F0] rounded-2xl p-9 text-center hover:border-[#D4E3F5] transition-all">
          <div class="w-16 h-16 rounded-full bg-[#EDF2FA] border-2 border-[#D4E3F5] flex items-center justify-center mx-auto mb-5">
            <svg class="w-7 h-7 text-[#4B8BD4]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/></svg>
          </div>
          <div class="text-xs font-bold uppercase tracking-wider text-[#4B8BD4] mb-2.5">Step 2</div>
          <h3 class="font-serif text-lg font-bold text-[#1B3A5C] mb-3">Let It Check Your Computer</h3>
          <p class="text-[#5A6474] text-base leading-relaxed">WorkInPrivate looks at your computer and sets up an AI that will run well on it. The guided setup handles the technical parts so you don't have to.</p>
        </div>
        <!-- Step 3 -->
        <div class="bg-[#F7F9FC] border-2 border-[#E2E8F0] rounded-2xl p-9 text-center hover:border-[#D4E3F5] transition-all">
          <div class="w-16 h-16 rounded-full bg-[#EDF2FA] border-2 border-[#D4E3F5] flex items-center justify-center mx-auto mb-5">
            <svg class="w-7 h-7 text-[#4B8BD4]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0110 0v4"/></svg>
          </div>
          <div class="text-xs font-bold uppercase tracking-wider text-[#4B8BD4] mb-2.5">Step 3</div>
          <h3 class="font-serif text-lg font-bold text-[#1B3A5C] mb-3">Start Chatting Privately</h3>
          <p class="text-[#5A6474] text-base leading-relaxed">Ask questions, write emails, brainstorm, or analyze documents — just like ChatGPT. Everything you type stays on your machine, and it works without an internet connection.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Features Section -->
  <section class="py-20 bg-white border-t-2 border-[#E2E8F0]">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <div class="text-xs font-bold uppercase tracking-widest text-[#4B8BD4] mb-3">Features</div>
        <h2 class="font-serif text-3xl sm:text-4xl font-bold text-[#1B3A5C] mb-4 leading-tight">Everything You Need, Nothing You Don't</h2>
        <p class="text-lg text-[#5A6474] max-w-lg mx-auto">All the everyday AI help you'd expect — kept completely private and simple to use.</p>
      </div>
      <div class="max-w-5xl mx-auto grid grid-cols-1 sm:grid-cols-2 gap-6">
        <div class="bg-white border-2 border-[#E2E8F0] rounded-xl p-7 flex gap-4 hover:border-[#D4E3F5] transition-colors">
          <div class="w-12 h-12 rounded-xl bg-[#EDF2FA] flex items-center justify-center flex-shrink-0">
            <svg class="w-6 h-6 text-[#4B8BD4]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/></svg>
          </div>
          <div>
            <h3 class="font-bold text-[#1B3A5C] text-base mb-1">Free-Form Chat</h3>
            <p class="text-[#5A6474] text-sm leading-relaxed">Chat naturally with AI just like you would with ChatGPT. Ask questions, brainstorm, write, revise — anything you need.</p>
          </div>
        </div>
        <div class="bg-white border-2 border-[#E2E8F0] rounded-xl p-7 flex gap-4 hover:border-[#D4E3F5] transition-colors">
          <div class="w-12 h-12 rounded-xl bg-[#F0FFF4] flex items-center justify-center flex-shrink-0">
            <svg class="w-6 h-6 text-[#38A169]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14,2 14,8 20,8"/></svg>
          </div>
          <div>
            <h3 class="font-bold text-[#1B3A5C] text-base mb-1">File Analysis</h3>
            <p class="text-[#5A6474] text-sm leading-relaxed">Drop in PDFs, Word docs, images, and code files. The AI reads them and helps you understand, summarize, or work with the content.</p>
          </div>
        </div>
        <div class="bg-white border-2 border-[#E2E8F0] rounded-xl p-7 flex gap-4 hover:border-[#D4E3F5] transition-colors">
          <div class="w-12 h-12 rounded-xl bg-[#EDF2FA] flex items-center justify-center flex-shrink-0">
            <svg class="w-6 h-6 text-[#4B8BD4]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0110 0v4"/></svg>
          </div>
          <div>
            <h3 class="font-bold text-[#1B3A5C] text-base mb-1">Complete Privacy</h3>
            <p class="text-[#5A6474] text-sm leading-relaxed">Everything runs locally. No cloud servers, no accounts, no telemetry. Your conversations never leave your computer.</p>
          </div>
        </div>
        <div class="bg-white border-2 border-[#E2E8F0] rounded-xl p-7 flex gap-4 hover:border-[#D4E3F5] transition-colors">
          <div class="w-12 h-12 rounded-xl bg-[#F0FFF4] flex items-center justify-center flex-shrink-0">
            <svg class="w-6 h-6 text-[#38A169]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M16 8h-6a2 2 0 000 4h4a2 2 0 010 4H8"/><line x1="12" y1="6" x2="12" y2="8"/><line x1="12" y1="16" x2="12" y2="18"/></svg>
          </div>
          <div>
            <h3 class="font-bold text-[#1B3A5C] text-base mb-1">One-Time Purchase</h3>
            <p class="text-[#5A6474] text-sm leading-relaxed">$29.99 once. No subscription, no usage limits, no surprises on your credit card. Use it as much as you want, forever.</p>
          </div>
        </div>
        <div class="bg-white border-2 border-[#E2E8F0] rounded-xl p-7 flex gap-4 hover:border-[#D4E3F5] transition-colors">
          <div class="w-12 h-12 rounded-xl bg-[#EDF2FA] flex items-center justify-center flex-shrink-0">
            <svg class="w-6 h-6 text-[#4B8BD4]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>
          </div>
          <div>
            <h3 class="font-bold text-[#1B3A5C] text-base mb-1">Works Offline</h3>
            <p class="text-[#5A6474] text-sm leading-relaxed">After the initial setup, no internet connection needed. Perfect for travel, restricted networks, or just peace of mind.</p>
          </div>
